{
  "name": "@grupodiariodaregiao/bunstone",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "version": "1.2.2",
  "homepage": "https://github.com/diariodaregiao/bunstone#readme",
  "repository": {
    "url": "https://github.com/diariodaregiao/bunstone.git",
    "type": "git"
  },
  "type": "module",
  "bin": {
    "bunstone": "./bin/cli.ts"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "tsconfig.json",
    "docs/**/*.md",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "llms.txt",
    "MIGRATION.md"
  ],
  "scripts": {
    "agents:build": "bun run ./scripts/generate-agents.ts",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "typecheck": "bun check --no-script",
    "build": "rm -rf dist && bun build ./index.ts --outdir ./dist --target bun --packages external && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --outDir dist && tsc-alias -p tsconfig.build.json --outDir dist",
    "format": "bun fmt --no-script src bin tests index.ts",
    "format:check": "bun fmt --no-script --check src bin tests index.ts",
    "verify": "bun run typecheck && bun run format:check && bun test",
    "benchmark": "bun run ./benchmarks/run.ts",
    "prepack": "npm run build && npm run agents:build"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/autocannon": "^7.12.7",
    "@types/bun": "1.4.4",
    "autocannon": "^8.0.0",
    "bun-types": "1.4.4",
    "mongodb": "^6.10.0",
    "tsc-alias": "^1.9.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "mongodb": "^6.10.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.217.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "amqplib": "^0.10.4",
    "jose": "^6.2.3",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.3.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    }
  }
}
